# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your values.
# NEVER commit .env to git (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Required: auth token that the Android client must send in X-Backup-Token header.
# Generate a strong token with:
#   macOS / Linux:  python3 -c "import secrets; print(secrets.token_hex(32))"
#   Windows:        python  -c "import secrets; print(secrets.token_hex(32))"
UPLOAD_TOKEN=your_long_random_secret_here

# Optional: override the directory where received files are stored.
# Defaults to ./Android_Media_Backup  (relative to server.py)
# macOS / Linux example:
#   BACKUP_DIR=/home/yourname/MediaBackup
# Windows example (use forward slashes or double backslashes):
#   BACKUP_DIR=C:/Users/yourname/MediaBackup
# BACKUP_DIR=
