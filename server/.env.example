# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your values.
# NEVER commit .env to git (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Required: auth token that the Android client must send in X-Backup-Token header.
# Generate with:
#   macOS / Linux:  python3 -c "import secrets; print(secrets.token_hex(32))"
#   Windows:        python  -c "import secrets; print(secrets.token_hex(32))"
UPLOAD_TOKEN=your_long_random_secret_here

# Required for auto-setup: password that protects the GET /setup-token endpoint.
# The ESP32 firmware sends this in X-Setup-Password to fetch the UPLOAD_TOKEN
# and save it automatically to ~/.backup_token on the Android device.
# Generate a different value from UPLOAD_TOKEN:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
# Leave empty to disable the /setup-token endpoint entirely.
SETUP_PASSWORD=your_setup_password_here

# Also embed SETUP_PASSWORD in fetch_photos.ino at line:
#   #define SETUP_PASSWORD "your_setup_password_here"
# Then re-flash the ESP32.

# Optional: override the directory where received files are stored.
# Defaults to ./Android_Media_Backup  (relative to server.py)
# macOS / Linux:  BACKUP_DIR=/home/yourname/MediaBackup
# Windows:        BACKUP_DIR=C:/Users/yourname/MediaBackup
# BACKUP_DIR=
