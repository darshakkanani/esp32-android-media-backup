# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Required: auth token that the Android client must send in X-Backup-Token header.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
UPLOAD_TOKEN=your_long_random_secret_here

# Optional: override the directory where received files are stored.
# Defaults to ./Android_Media_Backup  (relative to server.py)
# BACKUP_DIR=/absolute/path/to/backup_dir
